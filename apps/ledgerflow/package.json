{
  "name": "ledgerflow",
  "productName": "AICOM",
  "description": "AICOM — gestion commerciale, caisse et comptabilité",
  "author": "AICOM",
  "private": true,
  "version": "0.2.9",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "lint": "oxlint",
    "test": "node --test \"electron/*.test.ts\" \"tests/*.test.ts\" && vitest run",
    "test:ui": "vitest run",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env.server dist/server/index.js",
    "build:desktop": "tsc -b && vite build && vite build --config vite.electron.config.ts",
    "desktop": "npm run build:desktop && node scripts/desktop.mjs",
    "desktop:dev": "vite build --config vite.electron.config.ts && node scripts/desktop.mjs --dev",
    "dist": "node node_modules/electron/install.js && npm run build:desktop && electron-builder --win --publish never"
  },
  "dependencies": {
    "@firebase/app": "^0.16.2",
    "@firebase/auth": "^1.13.6",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@google-cloud/storage": "^8.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.49.0",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "jsdom": "^30.1.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    }
  },
  "build": {
    "appId": "com.aicom.desktop",
    "productName": "AICOM",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "compression": "maximum",
    "files": [
      "dist/**/*",
      "!dist/server/**/*",
      "dist-electron/**/*",
      "electron/preload.cjs",
      "build/aicom.ico",
      "desktop.config.json",
      "package.json",
      "!**/node_modules/**/*"
    ],
    "win": {
      "icon": "build/aicom.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "AICOM",
      "artifactName": "AICOM-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "generic",
      "url": "https://updates.invalid/aicom"
    }
  }
}
